        --format '{{(index (index .NetworkSettings.Ports "3000/tcp") 0).HostPort}}' \
        "$APP_CONTAINER"
)"

test -n "$TRUSTED_HOST_PORT"

TRUSTED_READY=0

for _ in $(seq 1 60); do
    RUNNING="$(
        docker inspect \
            --format '{{.State.Running}}' \
            "$APP_CONTAINER"
    )"

    if [ "$RUNNING" != 'true' ]; then
        printf '%s\n' \
            'ERROR: trusted-proxy application exited during startup' >&2

        docker logs \
            "$APP_CONTAINER" >&2 \
            || true

        exit 1
    fi

    if curl \
        --fail \
        --silent \
        --show-error \
        "http://127.0.0.1:${TRUSTED_HOST_PORT}/" \
        >/dev/null 2>&1
    then
        TRUSTED_READY=1
        break
    fi

    sleep 0.25
done

test "$TRUSTED_READY" -eq 1

TRUSTED_STATUS="$(
    curl \
        --silent \
        --show-error \
        --output /dev/null \
        --write-out '%{http_code}' \
        --header "X-Forwarded-For: $FORWARDED_PROOF_IP" \

            'route=/contacts/list' \
        | tail -n 1
)"

test -n "$TRUSTED_EVENT"

printf '%s\n' \
    "$TRUSTED_EVENT" \
    | grep -Fq \
        "client_ip=$FORWARDED_PROOF_IP"

printf '%s\n' \
    'trusted proxy forwarded client address was accepted'

docker rm \
    --force \
    "$APP_CONTAINER" \
    >/dev/null


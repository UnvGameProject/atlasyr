#!/usr/bin/env bash
(
set -euo pipefail

PROJECT_ROOT="$(
    CDPATH= cd -- "$(dirname -- "$0")" &&
    pwd
)"

cd "$PROJECT_ROOT"

APP_IMAGE='topcoat-poc-production-app:smoke'
MIGRATE_IMAGE='topcoat-poc-production-migrate:smoke'
CREATE_USER_IMAGE='topcoat-poc-production-create-user:smoke'

APP_CONTAINER='topcoat-poc-production-smoke-app'

TEMP_DIR="$(
    mktemp -d
)"

cleanup() {
    docker rm \
        --force \
        "$APP_CONTAINER" \
        >/dev/null 2>&1 \
        || true

    rm -rf "$TEMP_DIR"
}

trap cleanup EXIT HUP INT TERM

compose() {
    docker compose \
        --project-directory "$PROJECT_ROOT" \
        -f "$PROJECT_ROOT/compose.yaml" \
        "$@"
}

printf '\n===== BUILD PRODUCTION TARGETS =====\n'

docker build \
    --file Dockerfile.prod \
    --target app \
    --tag "$APP_IMAGE" \
    .

docker build \
    --file Dockerfile.prod \
    --target migrate \
    --tag "$MIGRATE_IMAGE" \
    .

docker build \
    --file Dockerfile.prod \
    --target create-user \
    --tag "$CREATE_USER_IMAGE" \
    .

printf '\n===== VERIFY IMAGE USERS + ENTRYPOINTS =====\n'

test "$(
    docker image inspect \
        --format '{{.Config.User}}' \
        "$APP_IMAGE"
)" = '10001:10001'

test "$(
    docker image inspect \
        --format '{{.Config.User}}' \
        "$MIGRATE_IMAGE"
)" = '10001:10001'

test "$(
    docker image inspect \
        --format '{{.Config.User}}' \
        "$CREATE_USER_IMAGE"
)" = '10001:10001'

test "$(
    docker image inspect \
        --format '{{json .Config.Entrypoint}}' \
        "$APP_IMAGE"
)" = '["/app/topcoat-poc"]'

test "$(
    docker image inspect \
        --format '{{json .Config.Entrypoint}}' \
        "$MIGRATE_IMAGE"
)" = '["/app/migrate"]'

test "$(
    docker image inspect \
        --format '{{json .Config.Entrypoint}}' \
        "$CREATE_USER_IMAGE"
)" = '["/app/create-user"]'

printf '%s\n' \
    'production targets use the dedicated non-root runtime identity'

printf '\n===== VERIFY APP IMAGE PACKAGE SURFACE =====\n'

docker run \
    --rm \
    --entrypoint /bin/sh \
    "$APP_IMAGE" \
    -c '
        set -eu

        test "$(id -u)" = 10001
        test "$(id -g)" = 10001

        test -x /app/topcoat-poc
        test -s /app/assets/manifest.toml
        test -d /app/resources/views

        test "$(
            find /app/resources/views \
                -type f \
                | wc -l
        )" -eq 9

        for command in \
            cargo \
            rustc \
            rustup \
            topcoat \
            node \
            npm
        do
            if command -v "$command" >/dev/null 2>&1; then
                printf "ERROR: build tool present in app image: %s\n" \
                    "$command" >&2
                exit 1
            fi
        done

        for path in \
            /app/src \
            /app/crates \
            /app/tests \
            /app/tools \
            /app/docker \
            /app/migrations \
            /app/.sqlx \
            /app/.secrets \
            /app/node_modules \
            /app/Cargo.toml \
            /app/Cargo.lock \
            /app/package.json \
            /app/package-lock.json \
            /app/Dockerfile.dev \
            /app/Dockerfile.prod \
            /app/compose.yaml \
            /app/deny.toml \
            /app/dependency-audit
        do
            if [ -e "$path" ]; then
                printf "ERROR: development artifact present: %s\n" \
                    "$path" >&2
                exit 1
            fi
        done

        test ! -e /app/migrate
        test ! -e /app/create-user

        printf "%s\n" \
            "app runtime package surface is minimal"
    '

printf '\n===== VERIFY OPERATIONAL TARGET ISOLATION =====\n'

docker run \
    --rm \
    --entrypoint /bin/sh \
    "$MIGRATE_IMAGE" \
    -c '
        set -eu

        test -x /app/migrate
        test ! -e /app/topcoat-poc
        test ! -e /app/create-user
        test ! -e /app/assets
        test ! -e /app/resources
        test ! -e /app/migrations

        printf "%s\n" \
            "migration target contains no application presentation package"
    '

docker run \
    --rm \
    --entrypoint /bin/sh \
    "$CREATE_USER_IMAGE" \
    -c '
        set -eu

        test -x /app/create-user
        test ! -e /app/topcoat-poc
        test ! -e /app/migrate
        test ! -e /app/assets
        test ! -e /app/resources
        test ! -e /app/migrations

        printf "%s\n" \
            "create-user target contains no application presentation package"
    '

printf '\n===== VERIFY APP DYNAMIC LIBRARIES RESOLVE =====\n'

docker run \
    --rm \
    --entrypoint /usr/bin/ldd \
    "$APP_IMAGE" \
    /app/topcoat-poc \
    | tee "$TEMP_DIR/ldd.txt"

if grep -q 'not found' "$TEMP_DIR/ldd.txt"; then
    printf '%s\n' \
        'ERROR: unresolved production runtime library' >&2
    exit 1
fi

printf '\n===== VERIFY PRODUCTION DEFAULTS =====\n'

docker image inspect \
    "$APP_IMAGE" \
    > "$TEMP_DIR/app-image.json"

python3 - "$TEMP_DIR/app-image.json" <<'PY'
from pathlib import Path
import json
import sys

data = json.loads(
    Path(sys.argv[1]).read_text()
)

environment = set(
    data[0]["Config"].get("Env") or []
)

required = {
    "APP_ENV=production",
    "AUTH_DRIVER=local-topcoat",
    "HOST=0.0.0.0",
    "PORT=3000",
}

missing = required - environment

if missing:
    raise SystemExit(
        "production image defaults missing: "
        + ", ".join(sorted(missing))
    )

print("production application defaults verified")
PY

printf '\n===== VERIFY PACKAGED ASSET BUNDLE =====\n'

docker run \
    --rm \
    --entrypoint /bin/sh \
    "$APP_IMAGE" \
    -c '
        set -eu

        test -s /app/assets/manifest.toml

        count="$(
            find /app/assets \
                -maxdepth 1 \
                -type f \
                ! -name manifest.toml \
                | wc -l
        )"

        test "$count" -ge 4

        printf "bundled asset files: %s\n" "$count"
    '

printf '\n===== START DATABASE FOR RUNTIME SMOKE =====\n'

compose up -d postgres

POSTGRES_ID="$(
    compose ps -q postgres
)"

test -n "$POSTGRES_ID"

NETWORK="$(
    docker inspect "$POSTGRES_ID" |
        python3 -c '
import json
import sys

data = json.load(sys.stdin)

networks = list(
    data[0]["NetworkSettings"]["Networks"]
)

if len(networks) != 1:
    raise SystemExit(
        "expected postgres to have exactly one compose network, "
        f"found {networks}"
    )

print(networks[0])
'
)"

test -n "$NETWORK"

test -r "$PROJECT_ROOT/.secrets/postgres_migrator_password"
test -r "$PROJECT_ROOT/.secrets/postgres_app_password"

printf 'compose network: %s\n' "$NETWORK"

printf '\n===== RUN PRODUCTION MIGRATION ARTIFACT =====\n'

docker run \
    --rm \
    --network "$NETWORK" \
    --env DB_HOST=postgres \
    --env DB_PORT=5432 \
    --env DB_NAME=topcoat_poc \
    --env DB_USER=topcoat_migrator \
    --env DB_PASSWORD_FILE=/run/secrets/database_password \
    --mount \
        "type=bind,src=$PROJECT_ROOT/.secrets/postgres_migrator_password,dst=/run/secrets/database_password,readonly" \
    "$MIGRATE_IMAGE"

printf '%s\n' \
    'production migration artifact executed successfully'

printf '\n===== START PRODUCTION APPLICATION IMAGE =====\n'

docker rm \
    --force \
    "$APP_CONTAINER" \
    >/dev/null 2>&1 \
    || true

docker run \
    --detach \
    --name "$APP_CONTAINER" \
    --network "$NETWORK" \
    --publish 127.0.0.1::3000 \
    --env DB_HOST=postgres \
    --env DB_PORT=5432 \
    --env DB_NAME=topcoat_poc \
    --env DB_USER=topcoat_app \
    --env DB_PASSWORD_FILE=/run/secrets/database_password \
    --mount \
        "type=bind,src=$PROJECT_ROOT/.secrets/postgres_app_password,dst=/run/secrets/database_password,readonly" \
    "$APP_IMAGE" \
    >/dev/null

HOST_PORT="$(
    docker inspect \
        --format '{{(index (index .NetworkSettings.Ports "3000/tcp") 0).HostPort}}' \
        "$APP_CONTAINER"
)"

test -n "$HOST_PORT"

printf 'production smoke port: %s\n' "$HOST_PORT"

printf '\n===== VERIFY APPLICATION SERVES HTTP =====\n'

READY=0

for _ in $(seq 1 60); do
    RUNNING="$(
        docker inspect \
            --format '{{.State.Running}}' \
            "$APP_CONTAINER"
    )"

    if [ "$RUNNING" != 'true' ]; then
        printf '%s\n' \
            'ERROR: production application exited during startup' >&2

        docker logs "$APP_CONTAINER" >&2 || true
        exit 1
    fi

    if python3 - "$HOST_PORT" <<'PY' >/dev/null 2>&1
from urllib.request import urlopen
import sys

with urlopen(
    f"http://127.0.0.1:{sys.argv[1]}/",
    timeout=1,
) as response:
    if response.status != 200:
        raise SystemExit(1)
PY
    then
        READY=1
        break
    fi

    sleep 0.25
done

if [ "$READY" -ne 1 ]; then
    printf '%s\n' \
        'ERROR: production application never served the public home page' >&2

    docker logs "$APP_CONTAINER" >&2 || true
    exit 1
fi

printf '%s\n' \
    'production application served the public home page'

printf '\n===== VERIFY PACKAGED ASSET IS SERVED =====\n'

BUNDLED_ASSETS="$TEMP_DIR/bundled-assets.txt"

docker run \
    --rm \
    --entrypoint /bin/sh \
    "$APP_IMAGE" \
    -c '
        set -eu

        sed -n \
            "s/^file = \"\(.*\)\"/\1/p" \
            /app/assets/manifest.toml
    ' \
    > "$BUNDLED_ASSETS"

test -s "$BUNDLED_ASSETS"

python3 - "$HOST_PORT" "$BUNDLED_ASSETS" <<'PYASSET'
from html.parser import HTMLParser
from pathlib import Path, PurePosixPath
from urllib.parse import unquote, urljoin, urlparse
from urllib.request import urlopen
import sys


class AssetReferenceParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.references = []

    def handle_starttag(self, tag, attrs):
        for name, value in attrs:
            if (
                name in {"href", "src"}
                and value
            ):
                self.references.append(value)


port = sys.argv[1]

bundled = {
    line.strip()
    for line in Path(sys.argv[2]).read_text().splitlines()
    if line.strip()
}

if not bundled:
    raise SystemExit(
        "asset manifest contained no bundled filenames"
    )

base_url = f"http://127.0.0.1:{port}/"

with urlopen(
    base_url,
    timeout=3,
) as response:
    if response.status != 200:
        raise SystemExit(
            f"home page returned {response.status}"
        )

    html = response.read().decode(
        "utf-8",
        errors="replace",
    )

parser = AssetReferenceParser()
parser.feed(html)

matches = []

for reference in parser.references:
    parsed = urlparse(reference)
    filename = PurePosixPath(
        unquote(parsed.path)
    ).name

    if filename in bundled:
        matches.append(
            (reference, filename)
        )

if not matches:
    raise SystemExit(
        "home page emitted no URL matching "
        "a packaged Topcoat asset"
    )

unique_matches = list(
    dict.fromkeys(matches)
)

for reference, filename in unique_matches:
    url = urljoin(
        base_url,
        reference,
    )

    with urlopen(
        url,
        timeout=3,
    ) as response:
        if response.status != 200:
            raise SystemExit(
                f"asset returned {response.status}: {url}"
            )

        body = response.read()

        if not body:
            raise SystemExit(
                f"asset response was empty: {url}"
            )

    print(
        f"production asset served successfully: "
        f"{reference} ({filename})"
    )

print(
    "verified application-generated asset routes: "
    f"{len(unique_matches)}"
)
PYASSET

printf '\n===== STOP SUCCESSFUL APP INSTANCE =====\n'

docker rm \
    --force \
    "$APP_CONTAINER" \
    >/dev/null

printf '\n===== MISSING VIEW MUST FAIL STARTUP =====\n'

EMPTY_VIEWS="$TEMP_DIR/empty-views"
mkdir -p "$EMPTY_VIEWS"

set +e

docker run \
    --rm \
    --network "$NETWORK" \
    --env DB_HOST=postgres \
    --env DB_PORT=5432 \
    --env DB_NAME=topcoat_poc \
    --env DB_USER=topcoat_app \
    --env DB_PASSWORD_FILE=/run/secrets/database_password \
    --mount \
        "type=bind,src=$PROJECT_ROOT/.secrets/postgres_app_password,dst=/run/secrets/database_password,readonly" \
    --mount \
        "type=bind,src=$EMPTY_VIEWS,dst=/app/resources/views,readonly" \
    "$APP_IMAGE" \
    >"$TEMP_DIR/missing-view.log" \
    2>&1

MISSING_VIEW_STATUS=$?

set -e

test "$MISSING_VIEW_STATUS" -ne 0

grep -Eq \
    'startup-validation|view .* failed|template' \
    "$TEMP_DIR/missing-view.log"

printf '%s\n' \
    'missing production views fail closed during startup'

printf '\n===== MISSING ASSET BUNDLE MUST FAIL STARTUP =====\n'

EMPTY_ASSETS="$TEMP_DIR/empty-assets"
mkdir -p "$EMPTY_ASSETS"

set +e

docker run \
    --rm \
    --network "$NETWORK" \
    --env DB_HOST=postgres \
    --env DB_PORT=5432 \
    --env DB_NAME=topcoat_poc \
    --env DB_USER=topcoat_app \
    --env DB_PASSWORD_FILE=/run/secrets/database_password \
    --mount \
        "type=bind,src=$PROJECT_ROOT/.secrets/postgres_app_password,dst=/run/secrets/database_password,readonly" \
    --mount \
        "type=bind,src=$EMPTY_ASSETS,dst=/app/assets,readonly" \
    "$APP_IMAGE" \
    >"$TEMP_DIR/missing-assets.log" \
    2>&1

MISSING_ASSET_STATUS=$?

set -e

test "$MISSING_ASSET_STATUS" -ne 0

grep -Eq \
    'Topcoat asset bundle was not found|no asset bundle' \
    "$TEMP_DIR/missing-assets.log"

printf '%s\n' \
    'missing production asset bundle fails closed during startup'

printf '\n===== PRODUCTION PACKAGE SMOKE GREEN =====\n'
)
